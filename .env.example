# Copy to .env and fill in. .env is gitignored; this file is not.

# Application credentials from https://my.telegram.org (API development tools).
# Identifies telewave itself, not the account it logs in as.
TELEWAVE_API_ID=1234567
TELEWAVE_API_HASH=0123456789abcdef0123456789abcdef

# Telegram account to authenticate as, in international format.
TELEWAVE_PHONE_NUMBER=+15551234567
