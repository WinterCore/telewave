# Copy to .env and fill in. .env is gitignored; this file is not.

# Application credentials from https://my.telegram.org (API development tools).
# Identifies telewave itself, not the account it logs in as.
TELEWAVE_API_ID=1234567
TELEWAVE_API_HASH=0123456789abcdef0123456789abcdef

# Telegram account to authenticate as, in international format.
TELEWAVE_PHONE_NUMBER=+15551234567

# Postgres connection string for the crawler database.
DATABASE_URL=postgres://winter@127.0.0.1:5432/telewave

# Pacing knobs, in requests started per minute. Optional — defaults shown.
# Channel metadata sync: one getSupergroup + getChat pair per channel.
CHANNEL_SYNC_RATE_PER_MIN=3

# Message crawl pacing: one searchChatMessages request per tick, pagination included.
CRAWL_RATE_PER_MIN=6

# Audio file downloads.
DOWNLOAD_RATE_PER_MIN=2

# A channel is crawled again only when its last crawl is older than this, in minutes.
# 0 = always due. Default 360 = 6 hours.
CRAWL_STALE_AFTER_MIN=360
